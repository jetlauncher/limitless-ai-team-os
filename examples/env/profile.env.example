# Hermes profile env example
# Copy to ~/.hermes/profiles/<profile>/.env, then run: chmod 600 that file

TELEGRAM_BOT_TOKEN=
# Also set telegram.allowed_chats in the profile config.yaml to your own chat IDs —
# without an allowlist any Telegram user who finds the bot can drive your agent.
TELEGRAM_HOME_CHANNEL=<your-telegram-user-id>
TELEGRAM_HOME_CHANNEL_NAME=<your-name>

HERMES_PROFILE=<profile-name>
HERMES_AGENT_NAME=<Agent Display Name>

# Optional shared providers; can also live in root ~/.hermes/.env
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
