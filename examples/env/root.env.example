# Root Hermes environment example
# Copy to ~/.hermes/.env, fill in your own values, then run: chmod 600 ~/.hermes/.env

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

TELEGRAM_BOT_TOKEN=
# Also set telegram.allowed_chats in config.yaml to your own chat IDs — without an
# allowlist any Telegram user who finds the bot can drive your agent.
TELEGRAM_HOME_CHANNEL=<your-telegram-user-id>
TELEGRAM_HOME_CHANNEL_NAME=<your-name>

HERMES_PROFILE=default
HERMES_AGENT_NAME=Kelly
